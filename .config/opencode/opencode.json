{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "fff": {
      "command": ["fff-mcp"],
      "enabled": true,
      "type": "local"
    },
    "github": {
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/"
    }
  },
  "tools": {
    "codesearch": true,
    "websearch": true
  }
}
