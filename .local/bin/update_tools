#!/bin/zsh
# Update every package manager and agent CLI on this Mac.
# Each step runs even if an earlier one fails; failures are listed at the end.

failed=()
run() {
  print -P "%F{blue}==> $*%f"
  "$@" || failed+=("$*")
}

run brew update
run brew upgrade                 # formulae and casks, codex included
run brew cleanup --prune=30      # drop downloads older than 30 days
run mise self-update --yes
run mise upgrade                 # runtimes and npm: tools
run rustup update
run uv tool upgrade --all
run claude update
run opencode upgrade
run pi update self

if (( ${#failed} )); then
  print -P "%F{red}Failed:%f"
  print -l -- "  "${^failed}
  exit 1
fi
